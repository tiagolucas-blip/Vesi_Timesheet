+  }
+  function slotHours(s){
+    if(!s || s.b === null || s.e === null) return 0;
+    var d = s.e - s.b;
+    if(d < 0) d = profileFor(WORKDATES[0]).overnight ? d + 1440 : 0;
+    return round15(d/60);
+  }
+  /* Recomputes every duration from the time window. Called whenever a window
